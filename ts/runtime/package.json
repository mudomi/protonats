{
  "name": "@protonats/runtime",
  "version": "0.0.1",
  "description": "ProtoNats TypeScript runtime library",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@nats-io/nats-core": "^3.0.0",
    "@nats-io/transport-node": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
